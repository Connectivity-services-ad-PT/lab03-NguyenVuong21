  "item": [
    {
      "name": "01_Functional",
      "item": [
        {
          "name": "POST /api/v1/sensors/readings",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response contains readingId\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"readingId\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n\t\"sensorId\": \"SENS-001\",\n\t\"temperature\": 23.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/sensors/readings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sensors",
                "readings"
              ]
            }
          },
          "response": []
        }
      ]
    },
